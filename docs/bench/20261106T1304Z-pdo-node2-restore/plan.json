{
  "purpose": "Recover from the starved session: node 2 to Pre-operational, TPDO1 event timer back to 0",
  "authorization": "user 2026-11-06: do all relevant PDO testing, start the actual PDO stream, check the setup works and whether it can be stopped; document all timings",
  "steps": [
    {
      "send": "N2,p",
      "expect": "NMT admitted",
      "end": "NMT request",
      "end_timeout_s": 6,
      "note": "stop node 2's 10 ms stream"
    },
    {
      "send": "r",
      "expect": "NMT result released"
    },
    {
      "wait_s": 2
    },
    {
      "send": "W2,0,5,10,0",
      "expect": "PDO_WRITE admitted",
      "end": "END raw",
      "end_timeout_s": 15,
      "note": "restore TPDO1 event timer 0"
    },
    {
      "send": "r",
      "expect": "RELEASED record"
    },
    {
      "send": "n",
      "expect": "NETWORK",
      "end": "END network",
      "end_timeout_s": 5
    }
  ]
}
