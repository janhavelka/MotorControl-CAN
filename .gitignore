__pycache__/
*.pyc
/.build/
/.install/
/build/
/dist/
/.pio/

# ESP-IDF build output that idf.py writes next to any example or project.
# sdkconfig.defaults* and any committed sdkconfig.ci stay tracked.
build*/
managed_components/
dependencies.lock
sdkconfig
sdkconfig.old
sdkconfig.esp32*
# Bench evidence records the exact sdkconfig of each flashed firmware run.
!docs/bench/**/sdkconfig
