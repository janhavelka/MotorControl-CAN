# Application configuration for the OPTAK_FGI_2025 ESP32-S2 board (docs/hardware_bench.md):
# TJA1051 TXD GPIO17, RXD GPIO16, S GPIO18 (S high = silent, RX kept; R3 pulls S low).
# Bus bitrate is the fixture's DIP setting. Applies only with -DIDF_TARGET=esp32s2.
# CONFIG_MOTORCONTROLCAN_COMPILE_FIXTURE is not set
CONFIG_MOTORCONTROLCAN_CAN_TX_PIN=17
CONFIG_MOTORCONTROLCAN_CAN_RX_PIN=16
CONFIG_MOTORCONTROLCAN_CAN_BITRATE=1000000
CONFIG_MOTORCONTROLCAN_CAN_RX_DEPTH=16
CONFIG_MOTORCONTROLCAN_CAN_SILENT_PIN=18
CONFIG_MOTORCONTROLCAN_CAN_SILENT_LEVEL=1
