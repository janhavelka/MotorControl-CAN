# Shared by every target; the target itself is selected with -DIDF_TARGET.
CONFIG_MOTORCONTROLCAN_COMPILE_FIXTURE=y
CONFIG_FREERTOS_HZ=1000
# Prompt 56: the owner pass is CPU bound (measured 2026-11-19 at 160 MHz); both targets run 240 MHz.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
# CONFIG_PM_ENABLE is not set
# CONFIG_TWAI_ISR_CACHE_SAFE is not set
# CONFIG_TWAI_ISR_IN_IRAM is not set
# CONFIG_FREERTOS_SMP is not set
# CONFIG_SPIRAM is not set
