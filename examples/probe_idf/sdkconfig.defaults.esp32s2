# ESP32-S2 with 4 MB embedded flash, DIO, as the S2 bench image uses (examples/s2_bench).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
# B01: this internal-RAM S2 image has no cache-disabled ISR or timer callbacks.
CONFIG_ESP32S2_DATA_CACHE_0KB=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_RINGBUF_PLACE_ISR_FUNCTIONS_INTO_FLASH=y
# CONFIG_LIBC_LOCKS_PLACE_IN_IRAM is not set
# CONFIG_UART_ISR_IN_IRAM is not set
CONFIG_ESP_TIMER_TASK_STACK_SIZE=2048
