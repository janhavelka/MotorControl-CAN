CONFIG_IDF_TARGET="esp32s2"
CONFIG_FREERTOS_HZ=1000
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
# CONFIG_PM_ENABLE is not set
# CONFIG_TWAI_ISR_CACHE_SAFE is not set
# CONFIG_TWAI_ISR_IN_IRAM is not set
# CONFIG_FREERTOS_SMP is not set
# CONFIG_SPIRAM is not set
# B01: S2 has no PSRAM; conserve internal RAM without changing the owner task stack.
CONFIG_ESP32S2_DATA_CACHE_0KB=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_RINGBUF_PLACE_ISR_FUNCTIONS_INTO_FLASH=y
# CONFIG_LIBC_LOCKS_PLACE_IN_IRAM is not set
# CONFIG_UART_ISR_IN_IRAM is not set
CONFIG_ESP_TIMER_TASK_STACK_SIZE=2048
# Prompt 55 bench item (c): a third SDO channel for the absent node 3 beside fixture nodes 1 and 2.
# The library default stays 2; only this image sets it.
CONFIG_MOTORCONTROLCAN_SDO_CHANNELS=3
